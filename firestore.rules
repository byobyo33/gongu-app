rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function me() { return request.auth.token.email.lower(); }
    function isMember(storeId) {
      return signedIn() && me() in get(/databases/$(database)/documents/stores/$(storeId)).data.members;
    }
    match /stores/{storeId} {
      // 새 장부: 만든 사람 한 명만 들어 있어야 함
      allow create: if signedIn() && request.resource.data.members == [me()] && request.resource.data.ownerUid == request.auth.uid;
      // 초대된 사람만 읽고, 이름·사장님 닉네임·초대 목록을 바꿀 수 있음
      allow read: if signedIn() && me() in resource.data.members;
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.members.size() > 0;
      allow delete: if false;
      // 공구·주문·손님 등 장부 내용
      match /{col}/{docId} {
        allow read, write: if isMember(storeId);
      }
    }
  }
}
