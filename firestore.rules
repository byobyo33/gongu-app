rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.get('email', '').lower(); }
    function isGoogle() { return request.auth != null && email() != ''; }
    // 구글 이메일로 초대됐거나, 초대번호로 들어온 기기
    function inStore(d) {
      return request.auth != null
        && ((email() != '' && email() in d.get('members', []))
            || request.auth.uid in d.get('memberUids', []));
    }
    function isMember(storeId) { return inStore(get(/databases/$(database)/documents/stores/$(storeId)).data); }
    // 초대번호로 들어오기: 자기 기기 하나만 추가, 맞는 번호가 있어야 함
    function canJoin(storeId) {
      let inv = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data;
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames', 'joinCode'])
        && request.resource.data.memberUids == resource.data.get('memberUids', []).concat([request.auth.uid])
        && request.resource.data.memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
        && inv.storeId == storeId
        && inv.expiresAt > request.time.toMillis();
    }
    match /stores/{storeId} {
      allow create: if isGoogle() && request.resource.data.members == [email()] && request.resource.data.ownerUid == request.auth.uid;
      allow read: if inStore(resource.data);
      allow update: if (inStore(resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('members', []).size() + request.resource.data.get('memberUids', []).size() > 0)
        || canJoin(storeId);
      allow delete: if false;
      match /{col}/{docId} {
        allow read, write: if isMember(storeId);
      }
    }
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isMember(request.resource.data.storeId);
      allow delete: if isMember(resource.data.storeId);
    }
  }
}
